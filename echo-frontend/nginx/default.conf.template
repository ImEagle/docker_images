server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location = /healthz {
        access_log off;
        try_files /healthz =404;
    }

    # The deployer supplies API_UPSTREAM (for example http://echo-api.namespace.svc.cluster.local:8080).
    # Keeping this proxy here makes browser requests same-origin and avoids a browser CORS dependency.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Vite emits content-hashed production assets beneath /assets/.  They can be
    # cached indefinitely because a content change produces a new URL.  Do not
    # let a missing asset fall through to the SPA entry point.
    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # A missing JavaScript or stylesheet is a broken static-asset request, not
    # an SPA route.  Returning the entry document here causes module/MIME errors
    # and can leave clients running an inconsistent application version.
    location ~* \.(?:css|js|mjs)$ {
        try_files $uri =404;
    }

    # The document shell must always be revalidated so a new deployment is
    # discovered even when its hashed assets are cached for a long time.
    location = /index.html {
        try_files $uri =404;
        add_header Cache-Control "no-store, max-age=0" always;
    }

    location = / {
        try_files /index.html =404;
        add_header Cache-Control "no-store, max-age=0" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
